# An operator image that selects its own Maven mirror (MavenMirrorSpec, task 4.3 of
# add-sandbox-base-image; scenario sandbox/sandbox-egress "An operator selects a Maven mirror"):
# the sandbox base plus Maven and its JDK, grafted from the official Maven image in a stage of their
# own (design D13: the final stage downloads nothing), and the one ENV line design D12 promises an
# operator. The base's root-owned settings.xml is not touched. BASE is the base fixture's tag.
ARG BASE
FROM maven:3-eclipse-temurin-25 AS maven

FROM ${BASE}
USER root
COPY --from=maven /opt/java/openjdk /opt/java/openjdk
COPY --from=maven /usr/share/maven /usr/share/maven
ENV JAVA_HOME=/opt/java/openjdk \
    MAVEN_HOME=/usr/share/maven \
    PATH=/usr/share/maven/bin:/opt/java/openjdk/bin:${PATH}
ENV GNOMISH_MAVEN_MIRROR=http://mirror.invalid/maven2
USER gnome

# NFR-O1 of fix-operator-blockers: a failure the runner already reported to the operator is not
# logged a second time as Spring Boot's "Application run failed" record.
org.springframework.boot.SpringBootExceptionReporter=\
com.github.oinsio.gnomish.app.ReportedFailureExceptionReporter

# FR5, FR7 of add-project-registry (design D6): the operator configuration is assembled and checked
# before any bean exists.
org.springframework.boot.EnvironmentPostProcessor=\
com.github.oinsio.gnomish.app.OperatorConfigLoader

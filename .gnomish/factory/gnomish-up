#!/usr/bin/env bash
# Starts the factory daemon together with a view of what it is doing. Lives next to the
# gnomish wrapper and drives the factory only through it, so gnomish.env, gnomish.local.env,
# project.yaml and the secrets apply exactly as for any other invocation. Callable from any directory.
#
# Equivalent to running these two side by side, in two terminals:
#   .gnomish/factory/gnomish serve --slots=1 --dashboard --dashboard-out=.gnomish/factory/logs/dashboard.html
#   tail -F ~/.gnomish/projects/gnomish-factory/logs/<instance>.log
#
# The daemon renders the dashboard page itself (`--dashboard`) and prints
# `gnomish serve: dashboard -> <path>` when it starts. Ctrl-C stops both: the daemon drains its
# in-flight slots as it does on its own and writes a last page saying it stopped, then the log
# follower is torn down with it.
#
# The log follower is there because the daemon's console carries only WARN and above: the
# INFO narrative — what each gnome is doing, stage by stage — only reaches the log file.
# Without it a healthy run looks like a silent terminal.
#
#   .gnomish/factory/gnomish-up                        # GNOMISH_UP_SLOTS slots, opens the dashboard
#   .gnomish/factory/gnomish-up --slots=2              # any serve flag is passed straight through
#   .gnomish/factory/gnomish-up --drain --no-open --no-logs
#
# --no-open (skip the browser) and --no-logs (skip the log follower) are this script's own
# flags; everything else belongs to `gnomish serve` — except `--dashboard` and
# `--dashboard-out`, which this script always passes itself and refuses from the caller: the
# page lives in GNOMISH_DASHBOARD_DIR, so set that instead.
set -euo pipefail

factory_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
gnomish="$factory_dir/gnomish"

# The settings this script reads, resolved the way the wrapper resolves them: gnomish.env,
# then gnomish.local.env, then your shell. Read in a subshell, so nothing else from the env
# files leaks into this process — the wrapper loads them itself.
read_setting() {
    local name="$1"
    if [[ -n "${!name:-}" ]]; then
        printf '%s' "${!name}"
        return
    fi
    (
        for env_file in "$factory_dir/gnomish.env" "$factory_dir/gnomish.local.env"; do
            # shellcheck source=/dev/null
            if [[ -f "$env_file" ]]; then source "$env_file"; fi
        done
        printf '%s' "${!name:-}"
    )
}

# The factory writes one log per project and instance into its home:
# <home>/projects/<project>/logs/<instance>.log. The instance is GNOMISH_INSTANCE_NAME when the
# env files set it (the wrapper passes it on), the factory's `default` otherwise;
# `gnomish project show` prints the path.
factory_home="${GNOMISH_HOME:-$HOME/.gnomish}"
project_name="$(read_setting GNOMISH_PROJECT_NAME)"
instance_name="$(read_setting GNOMISH_INSTANCE_NAME)"
factory_log_dir="$factory_home/projects/$project_name/logs"
factory_log="$factory_log_dir/${instance_name:-default}.log"

dashboard_dir="$(read_setting GNOMISH_DASHBOARD_DIR)"
dashboard_out="$dashboard_dir/dashboard.html"
default_slots="$(read_setting GNOMISH_UP_SLOTS)"
render_wait_seconds="$(read_setting GNOMISH_UP_RENDER_WAIT_SECONDS)"
render_poll_interval_seconds=0.5

open_browser=1
follow_logs=1
serve_args=()
for arg in "$@"; do
    case "$arg" in
        --no-open) open_browser=0 ;;
        --no-logs) follow_logs=0 ;;
        --dashboard|--dashboard=*|--dashboard-out|--dashboard-out=*)
            echo "gnomish-up: $arg is this script's to pass — set GNOMISH_DASHBOARD_DIR to move the page" >&2
            exit 2
            ;;
        *) serve_args+=("$arg") ;;
    esac
done

# `--slots` is a real CLI flag, not a Spring property, so a second one is a usage error rather
# than an override — only default it when the caller left it out.
has_slots=0
for arg in ${serve_args[@]+"${serve_args[@]}"}; do
    case "$arg" in
        --slots|--slots=*) has_slots=1 ;;
    esac
done
if [[ $has_slots -eq 0 ]]; then
    serve_args=(--slots="$default_slots" ${serve_args[@]+"${serve_args[@]}"})
fi
serve_args+=(--dashboard --dashboard-out="$dashboard_out")

mkdir -p "$dashboard_dir" "$factory_log_dir"
# The previous run's page would satisfy the first-render wait below at once; remove it, so a
# page on disk means this daemon rendered it.
rm -f "$dashboard_out"

logs_pid=""
serve_pid=""
serve_stopping=0

# One daemon process, started in the background so this script can wait for its first page,
# and then waited on. Stopping it is this script's job, not the terminal's: bash starts the
# background jobs of a non-interactive script with SIGINT ignored, and the JVM keeps an ignored
# SIGINT ignored, so the daemon never sees the Ctrl-C itself. The trap turns it — and a TERM
# sent to this script — into exactly one SIGTERM to the daemon, which runs serve's shutdown
# hook (drain, then the final "stopped" page) the same way a TERM from anywhere else would. A
# second Ctrl-C sends nothing more: the drain is already under way.
# shellcheck disable=SC2329  # invoked by the trap and by cleanup
stop_serve() {
    [[ -n "$serve_pid" && $serve_stopping -eq 0 ]] || return 0
    serve_stopping=1
    kill -TERM "$serve_pid" 2>/dev/null || true
}

# shellcheck disable=SC2329  # invoked by the trap
cleanup() {
    # Only reached with the daemon alive when this script itself failed: never leave it orphaned.
    if [[ -n "$serve_pid" ]] && kill -0 "$serve_pid" 2>/dev/null; then
        stop_serve
        wait "$serve_pid" 2>/dev/null || true
    fi
    if [[ -n "$logs_pid" ]] && kill -0 "$logs_pid" 2>/dev/null; then
        kill "$logs_pid" 2>/dev/null || true
        wait "$logs_pid" 2>/dev/null || true
    fi
}
trap cleanup EXIT
trap stop_serve INT TERM

if [[ $follow_logs -eq 1 ]]; then
    # -n 0: this run's narrative only, not yesterday's. -F: follow by name, so the follower
    # survives logback rolling the file.
    # WARN and ERROR are dropped because the daemon's console already prints them — twice
    # would read as two incidents. The filter is anchored on the log pattern's level field, so
    # if the pattern changes it stops matching and every line passes: noisier, never quieter.
    # A process substitution rather than a pipeline, so that $! is the tail itself: killing
    # it closes the substitution and the filter exits on EOF.
    tail -n 0 -F "$factory_log" 2>/dev/null \
        > >(grep --line-buffered -Ev '\] (WARN|ERROR) +\[taskId=') &
    logs_pid=$!
    echo "gnomish-up: following $factory_log (INFO and below; WARN+ comes from the daemon itself)"
fi

echo "gnomish-up: starting the daemon — .gnomish/factory/gnomish serve ${serve_args[*]}"
"$gnomish" serve "${serve_args[@]}" &
serve_pid=$!

# Wait for the first render before opening the browser: a tab on a file that is not there
# yet is a blank page for no reason.
render_polls="$(awk -v total="$render_wait_seconds" -v step="$render_poll_interval_seconds" \
    'BEGIN { print int(total / step) }')"
for _ in $(seq 1 "$render_polls"); do
    [[ -s "$dashboard_out" ]] && break
    kill -0 "$serve_pid" 2>/dev/null || break
    [[ $serve_stopping -eq 0 ]] || break
    # A Ctrl-C kills the sleep too; that is the trap's business, not a failure of this script.
    sleep "$render_poll_interval_seconds" || true
done

if [[ $serve_stopping -eq 1 ]]; then
    :
elif ! kill -0 "$serve_pid" 2>/dev/null; then
    echo "gnomish-up: the daemon exited before its first dashboard render" >&2
elif [[ ! -s "$dashboard_out" ]]; then
    echo "gnomish-up: no page rendered within ${render_wait_seconds}s — not opening the browser; the daemon keeps running" >&2
elif [[ $open_browser -eq 1 ]] && command -v open >/dev/null 2>&1; then
    open "file://$dashboard_out"
fi

# A trapped signal interrupts `wait` with a status above 128 while the daemon is still
# draining, so wait again until the daemon itself has exited; its status is this script's.
serve_status=0
while :; do
    set +e
    wait "$serve_pid"
    serve_status=$?
    set -e
    kill -0 "$serve_pid" 2>/dev/null || break
done
exit "$serve_status"

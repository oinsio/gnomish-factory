# Git stand-ins that answer from a committed file: listings, versions, origin URLs.
# Grammar: the header of ../stand-in.sh. One section per preset; StandIn makes its link.

[for-each-ref-noisy]
# for-each-ref answers a blank line and an out-of-prefix ref ahead of the real task ref; the rest is
# the real git (TaskBranchListerSpec).
for-each-ref answer data/stdout-git#for-each-ref-noisy 0
* delegate git

[log-answer-per-run]
# git log answers what the spec wrote beside the link (a blank line ahead of a real commit); the
# rest is the real git (UsageHistoryWalkerEdgeCasesSpec).
log answer @log.out 0
* delegate git

[progressing-fetch]
# fetch prints a progress line every half second for two seconds, then succeeds: a transfer that
# keeps making progress past a short deadline (GitProcessRunnerProgressingTransferSpec).
rev-parse,--git-common-dir answer data/common#git-dir 0
fetch stderr data/stderr#fetch-progress
fetch delay 0.5
fetch stderr data/stderr#fetch-progress
fetch delay 0.5
fetch stderr data/stderr#fetch-progress
fetch delay 0.5
fetch stderr data/stderr#fetch-progress
fetch delay 0.5
fetch answer - 0

[ls-remote-hostile-symref]
# ls-remote answers a default-branch name carrying an escape sequence; the rest is the real git
# (RemoteDefaultBranchSpec).
ls-remote answer data/stdout-git#ls-remote-hostile-symref 0
* delegate git

[version-2-50]
# A git below the floor that records every invocation (GitVersionCheckSpec, GitVersionFloorSpec).
* record
* answer data/stdout-git#git-version-2-50 0

[version-2-51-0]
# A git exactly at the floor (GitVersionCheckSpec).
* answer data/stdout-git#git-version-2-51-0 0

[version-2-55-apple]
# A git above the floor, as Apple ships it (GitVersionCheckSpec).
* answer data/stdout-git#git-version-2-55-apple 0

[version-broken]
# A broken install: no version, an error, exit 1 (GitVersionCheckSpec).
* refuse 1 data/stderr#git-broken-install

[version-not-git]
# Something on the git path that is not git (GitVersionCheckSpec).
* answer data/stdout-git#not-a-git 0

[version-record-2-55]
# Records the argv, prints a supported version (GitVersionCheckSpec).
* record
* answer data/stdout-git#git-version-2-55 0

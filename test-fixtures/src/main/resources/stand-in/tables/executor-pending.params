# Executor stand-ins whose subject is a pending run (design D11 of migrate-verify-to-executor-contract):
# a pending answer the reader refuses, a verdict executor that goes pending, one that keeps its run in
# its working copy, one whose poll breaks the result schema — the conformance kit's pending cases.
# Grammar: the header of ../stand-in.sh. One section per preset; StandIn makes its link.

[verdict-deferring]
# The reference executor under a describe that lists the role verdict alone, with poll
# (data/executor-describe#verdict-poll): the conformance kit runs its pending cases in role verdict,
# so their polls name a working copy holding the content before start (design D11 of
# migrate-verify-to-executor-contract as amended 2026-11-14).
describe result data/executor-describe#verdict-poll
describe exit 0
start exec-sh steps/executor-run.sh
poll exec-sh steps/executor-run.sh

[pending-in-copy]
# The reference executor, except that it keeps its pending run in its working copy: a start under
# `defer` records it in the copy's `.git` and a poll reads it back from there, refusing the key when
# its own copy holds none (steps/pending-in-copy.sh) — the candidate the conformance kit's poll from a
# new working copy fails (design D11 of migrate-verify-to-executor-contract as amended 2026-11-14).
describe result data/executor-describe#reference
describe exit 0
start exec-sh steps/pending-in-copy.sh
poll exec-sh steps/pending-in-copy.sh

[pending-bad-hint]
# The reference executor's describe, and a start that answers `pending` with a wait hint out of
# range (data/executor-result#pending-bad-hint, `pollAfterMillis: -1`): the kit's pending-poll case
# run against it fails naming the field (design D19 of migrate-verify-to-executor-contract).
describe result data/executor-describe#reference
describe exit 0
start result data/executor-result#pending-bad-hint
start exit 0

[poll-breaks]
# The reference executor, except that every poll answers a result that breaks its schema
# (data/executor-result#malformed-answer): the kit's pending case fails on the poll's breach, which
# the poll's own observation judged.
describe result data/executor-describe#reference
describe exit 0
start exec-sh steps/executor-run.sh
poll result data/executor-result#malformed-answer
poll exit 0

[transform-scripted]
# A pollable transform program whose run lives outside its working copy (design D11 of
# extract-agent-round-runner, task 6.4a): describe lists the role transform alone, with poll
# (data/executor-describe#transform-poll); each start and poll answers the next line of the spec's
# `<link>.script` and logs to `<link>.heads` (steps/scripted-verdict.sh), as `[verdict-scripted]`.
* export SCRIPT_FILE @script
* export HEADS_FILE @heads
describe result data/executor-describe#transform-poll
describe exit 0
start run steps/scripted-verdict.sh
start exit 0
poll run steps/scripted-verdict.sh
poll exit 0

[transform-service-holding]
# The fixture service of the packaged-jar journey of a pending transform round (task 7.1 of
# extract-agent-round-runner, M5): a pollable transform program (data/executor-describe#transform-poll)
# whose run lives in the service, never in its working copy. Every request is recorded in the per-run
# `<link>.log` with the key it polls, so the log is the service's count of `start`s; `start` submits
# the job and answers pending with its key (data/executor-result#pending). A poll holds the job: it
# becomes a sleep a kill ends, so its record tells the spec the pending round commit was pushed (a poll
# follows the push). The spec re-points the link at [transform-service] for the next instance.
* record GNOMISH_PENDING_KEY
describe result data/executor-describe#transform-poll
describe exit 0
start result data/executor-result#pending
start exit 0
poll stall 900

[transform-service]
# The same service with the job finished: `start` answers pending with the same key, and a poll writes
# the job's change into the working copy it runs in (`new-1.txt`, steps/working-copy-edit.sh) and
# answers completed (data/executor-result#transform). Recorded as [transform-service-holding].
* record GNOMISH_PENDING_KEY
describe result data/executor-describe#transform-poll
describe exit 0
start result data/executor-result#pending
start exit 0
poll export EDIT files-1
poll run steps/working-copy-edit.sh
poll result data/executor-result#transform
poll exit 0
